#!/data/data/com.termux/files/usr/bin/bash
# roblox — Global wrapper untuk ROBLOX-OSINT

INSTALL_DIR="$HOME/roblox-osint"

# Cek folder
if [ ! -d "$INSTALL_DIR" ]; then
    echo "✗ Folder $INSTALL_DIR There isn't any."
    exit 1
fi

cd "$INSTALL_DIR" || exit 1

# Auto-setup venv kalau belum ada
if [ ! -d "venv" ]; then
    echo "[*] venv there isn't any yet, bikin..."
    python3 -m venv venv
    source venv/bin/activate
    pip install --upgrade pip -q
    pip install -r requirements.txt -q
else
    source venv/bin/activate
fi

# Cek yaml — kalau gak ada, install cepat
if ! python3 -c "import yaml" 2>/dev/null; then
    echo "[*]  Deps less, install..."
    pip install -r requirements.txt -q
fi

# Pass semua argumen ke main.py
exec python3 main.py "$@"
