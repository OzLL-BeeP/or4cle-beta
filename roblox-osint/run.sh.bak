#!/usr/bin/env bash
# run.sh — Wrapper untuk jalanin ROBLOX-OSINT

GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Auto-activate venv kalau ada
if [ -d "venv" ] && [ -z "$VIRTUAL_ENV" ]; then
    # shellcheck disable=SC1091
    source venv/bin/activate 2>/dev/null || true
fi

# Cek python
if ! command -v python3 &>/dev/null; then
    echo -e "${RED}✗${NC} Python3 gak ketemu"
    exit 1
fi

# Kalau gak ada argumen, tampilkan help
if [ $# -eq 0 ]; then
    echo ""
    echo "═══════════════════════════════════════════════════════"
    echo -e "  ${CYAN}ROBLOX-OSINT — RUNNER${NC}"
    echo "═══════════════════════════════════════════════════════"
    echo ""
    echo "Usage:"
    echo "  ./run.sh scan <username>              Scan user"
    echo "  ./run.sh scan <username> --report html"
    echo "  ./run.sh graph <username> --depth 2   Build network graph"
    echo "  ./run.sh report --format json         Lihat report"
    echo "  ./run.sh check                        Cek file kosong/isi"
    echo "  ./run.sh install                      Install deps"
    echo "  ./run.sh update                       Update script"
    echo "  ./run.sh help                         Bantuan"
    echo ""
    exit 0
fi

CMD="$1"
shift

case "$CMD" in
    scan|graph|report)
        python3 main.py "$CMD" "$@"
        ;;

    check)
        bash check_all.sh "$@"
        ;;

    install)
        bash install.sh
        ;;

    update)
        echo -e "${CYAN}[*]${NC} Update deps..."
        source venv/bin/activate 2>/dev/null || true
        pip install --upgrade -r requirements.txt
        echo -e "${GREEN}✓${NC} Update selesai"
        ;;

    help|-h|--help)
        bash run.sh
        ;;

    *)
        echo -e "${RED}✗${NC} Command gak dikenal: $CMD"
        echo "Coba: ./run.sh help"
        exit 1
        ;;
esac
